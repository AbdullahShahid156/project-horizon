model EmailCampaign {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @db.Uuid
  name            String    @db.VarChar(255)
  subject         String    @db.VarChar(500)
  previewText     String?   @db.VarChar(255)
  emailType       String    @default("promotional") @db.VarChar(50)
  htmlContent     String?
  markdownContent String?
  plainText       String?
  jsonContent     Json?
  brand           String?   @db.VarChar(255)
  audience        String?
  goal            String?   @db.VarChar(100)
  tone            String?   @db.VarChar(100)
  language        String    @default("English") @db.VarChar(50)
  cta             String?   @db.VarChar(500)
  product         String?   @db.VarChar(255)
  keywords        Json?
  templateId      String?   @db.Uuid
  status          String    @default("draft") @db.VarChar(20)
  sentAt          DateTime?
  openRate        Float?
  clickRate       Float?
  unsubscribeRate Float?
  recipientCount  Int       @default(0)
  aiGenerated     Boolean   @default(false)
  aiProvider      String?   @db.VarChar(50)
  aiLatencyMs     Float?
  emailMetadata   Json?
  isDeleted       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  history EmailHistory[]

  @@index([workspaceId])
  @@index([emailType])
  @@index([status])

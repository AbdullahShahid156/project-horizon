model EmailTemplate {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @db.Uuid
  name            String   @db.VarChar(255)
  description     String?
  category        String   @default("business") @db.VarChar(50)
  emailType       String   @db.VarChar(50)
  subject         String   @db.VarChar(500)
  previewText     String?  @db.VarChar(255)
  htmlContent     String
  markdownContent String?
  jsonContent     Json?
  variables       Json?
  thumbnailUrl    String?  @db.VarChar(500)
  isSystem        Boolean  @default(false)
  usageCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([workspaceId])
  @@index([emailType])
}

model EmailHistory {
  id            String   @id @default(uuid()) @db.Uuid
  campaignId    String   @db.Uuid
  action        String   @db.VarChar(50)
  contentBefore String?
  contentAfter  String?
  aiProvider    String?  @db.VarChar(50)
  latencyMs     Float?
  createdAt     DateTime @default(now())

  campaign EmailCampaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
  @@index([createdAt])
}

// ============================================================
// SOCIAL DOMAIN
// ============================================================

model SocialPost {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @db.Uuid
  campaignId       String?   @db.Uuid
  platform         String    @db.VarChar(50)
  postType         String    @default("single") @db.VarChar(50)
  content          String
  headline         String?   @db.VarChar(500)
  caption          String?
  hashtags         Json?
  cta              String?   @db.VarChar(500)
  emojis           Json?
  imageSuggestions Json?
  imageIds         Json?
  carouselContent  Json?
  storyContent     Json?
  reelScript       String?
  pollIdeas        Json?
  business         String?   @db.VarChar(255)
  brand            String?   @db.VarChar(255)
  targetAudience   String?
  goal             String?   @db.VarChar(100)
  tone             String?   @db.VarChar(100)
  keywords         Json?
  status           String    @default("draft") @db.VarChar(20)
  scheduledDate    String?   @db.VarChar(30)
  publishedAt      DateTime?
  performanceScore Float?
  aiGenerated      Boolean   @default(false)
  aiProvider       String?   @db.VarChar(50)
  aiLatencyMs      Float?
  socialMetadata   Json?
  isDeleted        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  campaign SocialCampaign?     @relation(fields: [campaignId], references: [id])
  history  SocialPostHistory[]

  @@index([workspaceId])
  @@index([campaignId])
  @@index([platform])
  @@index([status])
}

model SocialCampaign {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @db.Uuid
  name           String   @db.VarChar(255)
  description    String?
  platforms      Json?
  startDate      String?  @db.VarChar(30)
  endDate        String?  @db.VarChar(30)
  status         String   @default("active") @db.VarChar(20)
  targetAudience String?
  goals          Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  posts SocialPost[]

  @@index([workspaceId])
}

model SocialCalendar {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  postId      String?  @db.Uuid
  date        String   @db.VarChar(30)
  platform    String   @db.VarChar(50)
  status      String   @default("draft") @db.VarChar(20)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([date])
}

model SocialHashtag {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  tag         String   @db.VarChar(255)
  category    String?  @db.VarChar(100)
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([tag])
}

model SocialPostHistory {
  id            String   @id @default(uuid()) @db.Uuid
  postId        String   @db.Uuid
  action        String   @db.VarChar(50)
  contentBefore String?
  contentAfter  String?
  aiProvider    String?  @db.VarChar(50)
  latencyMs     Float?
  createdAt     DateTime @default(now())

  post SocialPost @relation(fields: [postId], references: [id])

  @@index([postId])
  @@index([createdAt])
}

// ============================================================
// IMAGE DOMAIN
// ============================================================

model Image {
  id               String   @id @default(uuid()) @db.Uuid
  workspaceId      String   @db.Uuid
  folderId         String?  @db.Uuid
  name             String   @db.VarChar(255)
  description      String?
  imageType        String   @db.VarChar(50)
  prompt           String?
  negativePrompt   String?
  style            String?  @db.VarChar(100)
  url              String?  @db.VarChar(500)
  thumbnailUrl     String?  @db.VarChar(500)
  localPath        String?  @db.VarChar(500)
  fileSize         Int?
  width            Int?
  height           Int?
  format           String   @default("png") @db.VarChar(20)
  mimeType         String?  @db.VarChar(50)
  imageMetadata    Json?
  generationParams Json?
  isFavorite       Boolean  @default(false)
  isDeleted        Boolean  @default(false)
  tags             Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  folder  ImageFolder?   @relation(fields: [folderId], references: [id])
  history ImageHistory[]

  @@index([workspaceId])
  @@index([folderId])
  @@index([imageType])
}

model ImageFolder {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  parentId    String?  @db.Uuid
  name        String   @db.VarChar(255)
  description String?
  color       String?  @db.VarChar(7)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   ImageFolder?  @relation("ImageFolderTree", fields: [parentId], references: [id])
  children ImageFolder[] @relation("ImageFolderTree")
  images   Image[]

  @@index([workspaceId])
  @@index([parentId])
}

model ImageHistory {
  id              String   @id @default(uuid()) @db.Uuid
  imageId         String   @db.Uuid
  action          String   @db.VarChar(50)
  params          Json?
  resultUrl       String?  @db.VarChar(500)
  resultLocalPath String?  @db.VarChar(500)
  provider        String?  @db.VarChar(50)
  latencyMs       Float?
  createdAt       DateTime @default(now())

  image Image @relation(fields: [imageId], references: [id])

  @@index([imageId])
}

// ============================================================
// BRAND DOMAIN
// ============================================================

model Brand {
  id                 String    @id @default(uuid()) @db.Uuid
  workspaceId        String    @db.Uuid
  name               String    @db.VarChar(255)
  slug               String    @db.VarChar(255)
  tagline            String?   @db.VarChar(500)
  industry           String?   @db.VarChar(255)
  description        String?
  targetAudience     String?
  brandPersonality   String?
  toneOfVoice        String?
  mission            String?
  vision             String?
  values             Json?
  primaryColor       String    @default("#6366F1") @db.VarChar(7)
  secondaryColor     String    @default("#4F46E5") @db.VarChar(7)
  accentColor        String    @default("#818CF8") @db.VarChar(7)
  typography         String?   @db.VarChar(255)
  logoStyle          String?   @db.VarChar(255)
  iconStyle          String?   @db.VarChar(255)
  brandSummary       String?
  taglineSuggestions Json?
  brandVoice         String?
  elevatorPitch      String?
  usp                String?
  colorPalette       Json?
  fontPairings       Json?
  iconSuggestions    Json?
  brandKeywords      Json?
  brandGuidelines    String?
  aiData             Json?
  currentVersion     Int       @default(1)
  isFavorite         Boolean   @default(false)
  isArchived         Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  versions BrandVersion[]
  assets   BrandAsset[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([deletedAt])
}

model BrandVersion {
  id            String   @id @default(uuid()) @db.Uuid
  brandId       String   @db.Uuid
  versionNumber Int
  data          Json
  changeSummary String?  @db.VarChar(500)
  createdAt     DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id])

  @@unique([brandId, versionNumber])
  @@index([brandId])
}

model BrandAsset {
  id            String   @id @default(uuid()) @db.Uuid
  brandId       String   @db.Uuid
  assetType     String   @db.VarChar(50)
  name          String   @db.VarChar(255)
  url           String?  @db.VarChar(500)
  data          Json?
  assetMetadata Json?
  createdAt     DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id])

  @@index([brandId])
}

// ============================================================
// INTEGRATIONS DOMAIN
// ============================================================

model Integration {
  id                  String    @id @default(uuid()) @db.Uuid
  workspaceId         String    @db.Uuid
  provider            String    @db.VarChar(50)
  name                String    @db.VarChar(255)
  status              String    @db.VarChar(20)
  healthStatus        String    @default("unknown") @db.VarChar(20)
  credentials         Json
  maskedCredentials   Json?
  config              Json?
  autoSync            Boolean   @default(false)
  syncIntervalMinutes Int       @default(60)
  lastSyncAt          DateTime?
  lastSyncStatus      String?   @db.VarChar(50)
  errorMessage        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  logs     IntegrationLog[]
  syncJobs SyncJob[]
  items    SyncedItem[]

  @@index([workspaceId])
  @@index([provider])
  @@index([status])
}

model IntegrationLog {
  id            String   @id @default(uuid()) @db.Uuid
  integrationId String   @db.Uuid
  action        String   @db.VarChar(50)
  status        String   @db.VarChar(20)
  message       String?
  details       Json?
  durationMs    Float?
  createdAt     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id])

  @@index([integrationId])
  @@index([createdAt])
}

model SyncJob {
  id            String    @id @default(uuid()) @db.Uuid
  integrationId String    @db.Uuid
  syncType      String    @db.VarChar(20)
  status        String    @db.VarChar(20)
  itemsSynced   Int       @default(0)
  itemsFailed   Int       @default(0)
  errorMessage  String?
  startedAt     DateTime
  completedAt   DateTime?
  durationMs    Float?

  integration Integration @relation(fields: [integrationId], references: [id])

  @@index([integrationId])
  @@index([startedAt])
}

model SyncedItem {
  id            String   @id @default(uuid()) @db.Uuid
  integrationId String   @db.Uuid
  externalId    String   @db.VarChar(255)
  itemType      String   @db.VarChar(50)
  title         String   @db.VarChar(500)
  summary       String?
  url           String?  @db.VarChar(500)
  metadata      Json?
  lastSyncedAt  DateTime
  createdAt     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id])

  @@unique([integrationId, externalId])
  @@index([integrationId])
  @@index([itemType])
}


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// CORE / IDENTITY
// ============================================================

model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique @db.VarChar(255)
  firstName      String?   @db.VarChar(100)
  lastName       String?   @db.VarChar(100)
  imageUrl       String?   @db.VarChar(500)
  authProvider   String    @default("supabase") @db.VarChar(50)
  authProviderId String?   @db.VarChar(255)
  timezone       String    @default("UTC") @db.VarChar(50)
  language       String    @default("en") @db.VarChar(10)
  emailVerified  Boolean   @default(false)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  memberships   Membership[]
  ownedOrgs     Organization[] @relation("OrganizationOwner")
  notifications Notification[]
  settings      Settings?
  sessions      Session[]
  activities    ActivityLog[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([deletedAt])
}

model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(255)
  slug      String    @unique @db.VarChar(255)
  logoUrl   String?   @db.VarChar(500)
  plan      String    @default("free") @db.VarChar(50)
  ownerId   String    @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner       User          @relation("OrganizationOwner", fields: [ownerId], references: [id])
  memberships Membership[]
  workspaces  Workspace[]
  activityLog ActivityLog[]
  auditLogs   AuditLog[]

  @@index([slug])
  @@index([ownerId])
  @@index([deletedAt])
}

model Membership {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  organizationId String    @db.Uuid
  email          String?   @db.VarChar(255)
  role           String    @default("member") @db.VarChar(50)
  status         String    @default("accepted") @db.VarChar(20)
  invitedAt      DateTime?
  joinedAt       DateTime  @default(now())
  deletedAt      DateTime?

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([deletedAt])
}

model Workspace {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String    @db.VarChar(255)
  slug           String    @db.VarChar(255)
  description    String?   @db.VarChar(500)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  projects     Project[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([deletedAt])
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  name        String    @db.VarChar(255)
  slug        String    @db.VarChar(255)
  description String?   @db.VarChar(500)
  status      String    @default("draft") @db.VarChar(50)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace    Workspace          @relation(fields: [workspaceId], references: [id])
  websites     GeneratedWebsite[]
  landingPages LandingPage[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([status])
  @@index([deletedAt])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  token        String   @unique @db.VarChar(500)
  ipAddress    String?  @db.VarChar(45)
  userAgent    String?  @db.VarChar(500)
  expiresAt    DateTime
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([token])
  @@index([lastActiveAt])
}

model Settings {
  id                 String  @id @default(uuid()) @db.Uuid
  userId             String  @unique @db.Uuid
  theme              String  @default("system") @db.VarChar(50)
  timezone           String  @default("UTC") @db.VarChar(50)
  language           String  @default("en") @db.VarChar(10)
  emailNotifications Boolean @default(true)
  pushNotifications  Boolean @default(true)
  data               Json?

  user User @relation(fields: [userId], references: [id])
}

model Notification {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  type       String   @default("info") @db.VarChar(50)
  title      String   @db.VarChar(255)
  message    String?  @db.Text
  entityType String?  @db.VarChar(50)
  entityId   String?  @db.Uuid
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([createdAt])
}

model ActivityLog {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  organizationId String   @db.Uuid
  action         String   @db.VarChar(50)
  entityType     String   @db.VarChar(50)
  entityId       String   @db.Uuid
  entityName     String   @default("") @db.VarChar(255)
  description    String?  @db.VarChar(500)
  icon           String   @default("Activity") @db.VarChar(50)
  metadata       Json?
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([userId])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  organizationId String   @db.Uuid
  action         String   @db.VarChar(50)
  resource       String   @db.VarChar(50)
  resourceId     String   @db.Uuid
  details        Json?
  ipAddress      String?  @db.VarChar(45)
  userAgent      String?  @db.VarChar(500)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([resource, resourceId])
}

// ============================================================
// WEBSITE DOMAIN
// ============================================================

model GeneratedWebsite {
  id               String    @id @default(uuid()) @db.Uuid
  projectId        String    @db.Uuid
  name             String    @db.VarChar(255)
  slug             String    @db.VarChar(255)
  status           String    @default("draft") @db.VarChar(50)
  currentVersion   Int       @default(1)
  generationPrompt Json?
  aiResponse       Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  project  Project          @relation(fields: [projectId], references: [id])
  versions WebsiteVersion[]

  @@unique([projectId, slug])
  @@index([projectId])
  @@index([status])
  @@index([deletedAt])
}

model WebsiteVersion {
  id            String   @id @default(uuid()) @db.Uuid
  websiteId     String   @db.Uuid
  versionNumber Int
  content       Json
  changeSummary String?  @db.VarChar(500)
  isAutoSave    Boolean  @default(false)
  createdAt     DateTime @default(now())

  website GeneratedWebsite @relation(fields: [websiteId], references: [id])

  @@unique([websiteId, versionNumber])
  @@index([websiteId])
  @@index([createdAt])
}

// ============================================================
// LANDING PAGE DOMAIN
// ============================================================

model LandingPage {
  id               String    @id @default(uuid()) @db.Uuid
  projectId        String    @db.Uuid
  name             String    @db.VarChar(255)
  slug             String    @db.VarChar(255)
  status           String    @default("draft") @db.VarChar(50)
  currentVersion   Int       @default(1)
  generationPrompt Json?
  aiResponse       Json?
  seoData          Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  project  Project              @relation(fields: [projectId], references: [id])
  versions LandingPageVersion[]

  @@unique([projectId, slug])
  @@index([projectId])
  @@index([status])
  @@index([deletedAt])
}

model LandingPageVersion {
  id            String   @id @default(uuid()) @db.Uuid
  landingPageId String   @db.Uuid
  versionNumber Int
  content       Json
  changeSummary String?  @db.VarChar(500)
  isAutoSave    Boolean  @default(false)
  createdAt     DateTime @default(now())

  landingPage LandingPage @relation(fields: [landingPageId], references: [id])

  @@unique([landingPageId, versionNumber])
  @@index([landingPageId])
  @@index([createdAt])
}

model LandingPageTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(255)
  slug         String   @unique @db.VarChar(255)
  description  String?  @db.VarChar(500)
  category     String   @db.VarChar(100)
  thumbnailUrl String?  @db.VarChar(500)
  content      Json
  isFeatured   Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// ============================================================
// CONTENT DOMAIN
// ============================================================

model ContentFolder {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  name        String   @db.VarChar(255)
  parentId    String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   ContentFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children ContentFolder[] @relation("FolderTree")
  items    ContentItem[]

  @@index([workspaceId])
  @@index([parentId])
}

model ContentItem {
  id                 String    @id @default(uuid()) @db.Uuid
  workspaceId        String    @db.Uuid
  folderId           String?   @db.Uuid
  title              String    @db.VarChar(500)
  slug               String    @db.VarChar(500)
  contentType        String    @db.VarChar(50)
  status             String    @default("draft") @db.VarChar(50)
  body               Json?
  htmlBody           String?
  plainBody          String?
  contentMetadata    Json?
  seoData            Json?
  promptData         Json?
  generationSettings Json?
  currentVersion     Int       @default(1)
  wordCount          Int       @default(0)
  isFavorite         Boolean   @default(false)
  isArchived         Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  folder   ContentFolder?   @relation(fields: [folderId], references: [id])
  versions ContentVersion[]
  tags     ContentItemTag[]

  @@index([workspaceId])
  @@index([contentType])
  @@index([status])
  @@index([folderId])
  @@index([deletedAt])
}

model ContentVersion {
  id              String   @id @default(uuid()) @db.Uuid
  contentId       String   @db.Uuid
  versionNumber   Int
  title           String   @db.VarChar(500)
  body            Json?
  htmlBody        String?
  plainBody       String?
  contentMetadata Json?
  changeSummary   String?  @db.VarChar(500)
  isAutoSave      Boolean  @default(false)
  createdAt       DateTime @default(now())

  content ContentItem @relation(fields: [contentId], references: [id])

  @@unique([contentId, versionNumber])
  @@index([contentId])
}

model ContentTemplate {
  id                 String   @id @default(uuid()) @db.Uuid
  workspaceId        String   @db.Uuid
  name               String   @db.VarChar(255)
  slug               String   @db.VarChar(255)
  description        String?  @db.VarChar(500)
  contentType        String   @db.VarChar(50)
  category           String   @default("general") @db.VarChar(100)
  body               Json
  systemPrompt       String?
  generationSettings Json?
  isShared           Boolean  @default(false)
  isFavorite         Boolean  @default(false)
  useCount           Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([workspaceId])
  @@index([contentType])
}

model ContentTag {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  name        String   @db.VarChar(100)
  color       String   @default("#6366F1") @db.VarChar(7)
  createdAt   DateTime @default(now())

  items ContentItemTag[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model ContentItemTag {
  contentItemId String @db.Uuid
  contentTagId  String @db.Uuid

  contentItem ContentItem @relation(fields: [contentItemId], references: [id])
  contentTag  ContentTag  @relation(fields: [contentTagId], references: [id])

  @@id([contentItemId, contentTagId])
}

model ContentExport {
  id        String   @id @default(uuid()) @db.Uuid
  contentId String   @db.Uuid
  format    String   @db.VarChar(20)
  fileUrl   String?  @db.VarChar(500)
  fileSize  Int?
  createdAt DateTime @default(now())

  @@index([contentId])
}

// ============================================================
// SEO DOMAIN
// ============================================================

model SEODomain {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String    @db.Uuid
  url            String    @db.VarChar(500)
  name           String    @db.VarChar(255)
  healthScore    Int       @default(0)
  technicalScore Int       @default(0)
  contentScore   Int       @default(0)
  lastAuditedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  audits          SEOAudit[]
  keywords        SEOKeyword[]
  keywordClusters SEOKeywordCluster[]
  schemas         SEOSchema[]
  reports         SEOReport[]
  recommendations SEORecommendation[]
  competitors     SEOCompetitor[]
  history         SEOHistory[]
  internalLinks   SEOInternalLink[]

  @@index([workspaceId])
}

model SEOAudit {
  id              String   @id @default(uuid()) @db.Uuid
  domainId        String   @db.Uuid
  url             String   @db.VarChar(500)
  status          String   @default("pending") @db.VarChar(50)
  overallScore    Int      @default(0)
  technicalScore  Int      @default(0)
  contentScore    Int      @default(0)
  onPageScore     Int      @default(0)
  offPageScore    Int      @default(0)
  issues          Json?
  recommendations Json?
  metrics         Json?
  rawData         Json?
  createdAt       DateTime @default(now())

  domain SEODomain      @relation(fields: [domainId], references: [id])
  pages  SEOAuditPage[]

  @@index([domainId])
  @@index([createdAt])
}

model SEOAuditPage {
  id               String   @id @default(uuid()) @db.Uuid
  auditId          String   @db.Uuid
  url              String   @db.VarChar(500)
  statusCode       Int?
  title            String?  @db.VarChar(500)
  metaDescription  String?  @db.VarChar(500)
  h1               String?  @db.VarChar(500)
  wordCount        Int      @default(0)
  internalLinks    Int      @default(0)
  externalLinks    Int      @default(0)
  imagesWithoutAlt Int      @default(0)
  issues           Json?
  score            Int      @default(0)
  createdAt        DateTime @default(now())

  audit SEOAudit @relation(fields: [auditId], references: [id])

  @@index([auditId])
}

model SEOKeyword {
  id           String   @id @default(uuid()) @db.Uuid
  domainId     String   @db.Uuid
  keyword      String   @db.VarChar(255)
  searchVolume Int      @default(0)
  difficulty   Int      @default(0)
  cpc          Float    @default(0)
  intent       String   @default("informational") @db.VarChar(50)
  keywordType  String   @default("primary") @db.VarChar(50)
  clusterId    String?  @db.Uuid
  position     Int?
  url          String?  @db.VarChar(500)
  isTracked    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  domain   SEODomain           @relation(fields: [domainId], references: [id])
  cluster  SEOKeywordCluster?  @relation(fields: [clusterId], references: [id])
  rankings SEOKeywordRanking[]

  @@index([domainId])
  @@index([clusterId])
  @@index([keyword])
}

model SEOKeywordCluster {
  id            String   @id @default(uuid()) @db.Uuid
  domainId      String   @db.Uuid
  name          String   @db.VarChar(255)
  description   String?  @db.VarChar(500)
  pillarKeyword String?  @db.VarChar(255)
  keywordCount  Int      @default(0)
  avgVolume     Int      @default(0)
  createdAt     DateTime @default(now())

  domain   SEODomain    @relation(fields: [domainId], references: [id])
  keywords SEOKeyword[]

  @@index([domainId])
}

model SEOKeywordRanking {
  id               String   @id @default(uuid()) @db.Uuid
  keywordId        String   @db.Uuid
  position         Int
  url              String?  @db.VarChar(500)
  previousPosition Int?
  change           Int      @default(0)
  checkedAt        DateTime @default(now())

  keyword SEOKeyword @relation(fields: [keywordId], references: [id])

  @@index([keywordId])
  @@index([checkedAt])
}

model SEOSchema {
  id         String   @id @default(uuid()) @db.Uuid
  domainId   String   @db.Uuid
  schemaType String   @db.VarChar(50)
  name       String   @db.VarChar(255)
  jsonLd     Json
  url        String?  @db.VarChar(500)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  domain SEODomain @relation(fields: [domainId], references: [id])

  @@index([domainId])
}

model SEOReport {
  id                   String    @id @default(uuid()) @db.Uuid
  domainId             String    @db.Uuid
  title                String    @db.VarChar(255)
  reportType           String    @db.VarChar(50)
  status               String    @default("pending") @db.VarChar(50)
  summary              Json?
  data                 Json?
  score                Int       @default(0)
  issuesCount          Int       @default(0)
  recommendationsCount Int       @default(0)
  fileUrl              String?   @db.VarChar(500)
  createdAt            DateTime  @default(now())
  completedAt          DateTime?

  domain SEODomain @relation(fields: [domainId], references: [id])

  @@index([domainId])
  @@index([createdAt])
}

model SEORecommendation {
  id          String    @id @default(uuid()) @db.Uuid
  domainId    String    @db.Uuid
  category    String    @db.VarChar(50)
  priority    String    @default("medium") @db.VarChar(20)
  title       String    @db.VarChar(500)
  description String?
  impact      String?   @db.VarChar(200)
  effort      String?   @db.VarChar(200)
  status      String    @default("open") @db.VarChar(50)
  url         String?   @db.VarChar(500)
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  domain SEODomain @relation(fields: [domainId], references: [id])

  @@index([domainId])
  @@index([status])
  @@index([priority])
}

model SEOCompetitor {
  id             String   @id @default(uuid()) @db.Uuid
  domainId       String   @db.Uuid
  competitorUrl  String   @db.VarChar(500)
  competitorName String   @db.VarChar(255)
  notes          String?
  analysis       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  domain SEODomain @relation(fields: [domainId], references: [id])

  @@index([domainId])
}

model SEOHistory {
  id        String   @id @default(uuid()) @db.Uuid
  domainId  String   @db.Uuid
  eventType String   @db.VarChar(50)
  data      Json?
  score     Int?
  createdAt DateTime @default(now())

  domain SEODomain @relation(fields: [domainId], references: [id])

  @@index([domainId])
  @@index([createdAt])
}

model SEOInternalLink {
  id             String   @id @default(uuid()) @db.Uuid
  domainId       String   @db.Uuid
  sourceUrl      String   @db.VarChar(500)
  targetUrl      String   @db.VarChar(500)
  anchorText     String?  @db.VarChar(255)
  suggestionType String   @default("related") @db.VarChar(50)
  isImplemented  Boolean  @default(false)
  createdAt      DateTime @default(now())

  domain SEODomain @relation(fields: [domainId], references: [id])

  @@index([domainId])
}

// ============================================================
// PERFORMANCE DOMAIN
// ============================================================

model PerformanceAudit {
  id                 String    @id @default(uuid()) @db.Uuid
  projectId          String    @db.Uuid
  url                String    @db.VarChar(500)
  status             String    @default("pending") @db.VarChar(50)
  overallScore       Int       @default(0)
  performanceScore   Int       @default(0)
  accessibilityScore Int       @default(0)
  bestPracticesScore Int       @default(0)
  seoScore           Int       @default(0)
  metrics            Json?
  issues             Json?
  recommendations    Json?
  resources          Json?
  createdAt          DateTime  @default(now())
  completedAt        DateTime?

  vitals   CoreWebVitals[]
  perfRecs PerformanceRecommendation[]

  @@index([projectId])
  @@index([createdAt])
}

model CoreWebVitals {
  id               String   @id @default(uuid()) @db.Uuid
  auditId          String   @db.Uuid
  url              String   @db.VarChar(500)
  lcp              Float    @default(0)
  lcpStatus        String   @default("none") @db.VarChar(20)
  inp              Float    @default(0)
  inpStatus        String   @default("none") @db.VarChar(20)
  cls              Float    @default(0)
  clsStatus        String   @default("none") @db.VarChar(20)
  fcp              Float    @default(0)
  fcpStatus        String   @default("none") @db.VarChar(20)
  ttfb             Float    @default(0)
  ttfbStatus       String   @default("none") @db.VarChar(20)
  speedIndex       Float    @default(0)
  speedIndexStatus String   @default("none") @db.VarChar(20)
  tbt              Float    @default(0)
  tbtStatus        String   @default("none") @db.VarChar(20)
  rawData          Json?
  createdAt        DateTime @default(now())

  audit PerformanceAudit @relation(fields: [auditId], references: [id])

  @@index([auditId])
}

model PerformanceRecommendation {
  id                   String    @id @default(uuid()) @db.Uuid
  auditId              String    @db.Uuid
  category             String    @db.VarChar(50)
  priority             String    @default("medium") @db.VarChar(20)
  title                String    @db.VarChar(500)
  problem              String?
  impact               String?   @db.VarChar(200)
  estimatedImprovement String?   @db.VarChar(200)
  implementationGuide  String?
  status               String    @default("open") @db.VarChar(50)
  createdAt            DateTime  @default(now())
  resolvedAt           DateTime?

  audit PerformanceAudit @relation(fields: [auditId], references: [id])

  @@index([auditId])
  @@index([status])
  @@index([priority])
}

model OptimizationHistory {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  eventType   String   @db.VarChar(50)
  data        Json?
  scoreBefore Int?
  scoreAfter  Int?
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
}

model PerformanceReport {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @db.Uuid
  title       String    @db.VarChar(255)
  status      String    @default("pending") @db.VarChar(50)
  summary     Json?
  data        Json?
  score       Int       @default(0)
  fileUrl     String?   @db.VarChar(500)
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([projectId])
  @@index([createdAt])
}

model ImageAudit {
  id                String   @id @default(uuid()) @db.Uuid
  auditId           String   @db.Uuid
  url               String   @db.VarChar(500)
  originalSize      Int      @default(0)
  optimizedSize     Int?
  format            String   @default("unknown") @db.VarChar(20)
  recommendedFormat String?  @db.VarChar(20)
  width             Int?
  height            Int?
  hasLazyLoading    Boolean  @default(false)
  hasAltText        Boolean  @default(false)
  issues            Json?
  savingsBytes      Int      @default(0)
  createdAt         DateTime @default(now())

  @@index([auditId])
}

model AssetAudit {
  id               String   @id @default(uuid()) @db.Uuid
  auditId          String   @db.Uuid
  url              String   @db.VarChar(500)
  assetType        String   @db.VarChar(50)
  size             Int      @default(0)
  gzippedSize      Int?
  isMinified       Boolean  @default(false)
  isRenderBlocking Boolean  @default(false)
  isUnused         Boolean  @default(false)
  cacheControl     String?  @db.VarChar(200)
  etag             String?  @db.VarChar(200)
  issues           Json?
  createdAt        DateTime @default(now())

  @@index([auditId])
}

// ============================================================
// EMAIL DOMAIN
